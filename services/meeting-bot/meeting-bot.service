[Unit]
Description=Telegram bot transcribing recordings into brain/projects/meetings
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/repos/dotfiles/services/meeting-bot
EnvironmentFile=%h/repos/dotfiles/.env
ExecStart=%h/repos/dotfiles/services/meeting-bot/.venv/bin/python bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
