[Unit]
Description=Laptop camera watch sending a Telegram photo on motion, off while ~/.alarm exists
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=%h/repos/dotfiles/.env
ExecStart=/usr/bin/python3 %h/repos/dotfiles/services/webcam-alarm/watch.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
