{
  "enableAllProjectMcpServers" : true,
  "enabledPlugins" : {
    "mcps@dsonyy" : true
  },
  "env" : {
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION" : "2000",
    "CLAUDE_CODE_SANDBOXED" : "1"
  },
  "extraKnownMarketplaces" : {
    "dsonyy" : {
      "source" : {
        "path" : "~\/repos\/dotfiles\/config",
        "source" : "directory"
      }
    }
  },
  "hooks" : {
    "Notification" : [
      {
        "hooks" : [
          {
            "command" : "python3 $HOME\/repos\/dotfiles\/config\/hooks\/play.py",
            "type" : "command"
          }
        ],
        "matcher" : ""
      }
    ],
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "command" : "[ \"$(uname)\" = Linux ] && python3 $HOME\/repos\/dotfiles\/config\/hooks\/telegram-session.py || true",
            "type" : "command"
          }
        ],
        "matcher" : "Bash"
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "[ -f \"$HOME\/lessons\/index.md\" ] && { echo 'Contents of ~\/lessons\/index.md (open matching lessons before starting a task):'; cat \"$HOME\/lessons\/index.md\"; } || true",
            "type" : "command"
          }
        ]
      }
    ]
  },
  "model" : "opus",
  "modelSettings" : {
    "claude-opus-5" : {
      "effortLevel" : "medium"
    }
  },
  "permissions" : {
    "allow" : [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "WebFetch",
      "WebSearch",
      "Skill",
      "mcp__sentry__*",
      "mcp__linear__*",
      "mcp__github__*",
      "mcp__db__*",
      "mcp__chrome-devtools__*",
      "mcp__betterstack__*",
      "mcp__claude_ai_Atlassian__*",
      "mcp__claude_ai_Excalidraw__*",
      "mcp__microsoft-azure__*",
      "mcp__elasticsearch__*"
    ],
    "ask" : [

    ],
    "defaultMode" : "bypassPermissions",
    "deny" : [

    ]
  },
  "skipDangerousModePermissionPrompt" : true,
  "theme" : "dark",
  "voice" : {
    "enabled" : true,
    "mode" : "hold"
  },
  "voiceEnabled" : true
}